// use prisma-next

model Application {
  id               String             @id @default(uuid())
  applicantName    String
  type             String             @default("SERVICE_REQUEST")
  priority         String             @default("LOW")
  status           String             @default("NEW")
  description      String?
  assignee         String?
  slaDeadline      TimestamptzString?
  serviceCatalogId String?
  service          ServiceCatalog?    @relation(fields: [serviceCatalogId], references: [id])
  changeRequestId  String?
  changeRequest    ChangeRequest?     @relation(fields: [changeRequestId], references: [id])
  problemId        String?
  problem          Problem?           @relation(fields: [problemId], references: [id])
  createdAt        TimestamptzString  @default(now())
  auditLogs        AuditLog[]

  // Extended form and requester metadata
  formType         String?
  subtype          String?
  payload          Json?
  requesterEmail   String?

  // Prioritization and WSJF scoring
  bv               Float?
  r                Float?
  tc               Float?
  aw               Float?
  effort           Float?
  wsjf             Float?
  impact           String?
  urgency          String?
  severity         String?
  computedPriority String?

  // Tracking and assignment
  pocId            String?
  dueDate          TimestamptzString?
  clickupTaskId    String?
}

model AuditLog {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  changedBy     String
  createdAt     TimestamptzString @default(now())
}

model ServiceCatalog {
  id           String        @id @default(uuid())
  name         String        @unique
  category     String        @default("End-user Support")
  description  String?
  applications Application[]
}

model ChangeRequest {
  id           String   @id @default(uuid())
  title        String
  description  String
  type         String   @default("NORMAL")
  risk         String   @default("MEDIUM")
  status       String   @default("DRAFT")
  scheduledAt  TimestamptzString
  requestedBy  String
  approvedBy   String?
  createdAt    TimestamptzString @default(now())
  applications Application[]
}

model Problem {
  id               String            @id @default(uuid())
  title            String
  description      String
  status           String            @default("NEW")
  rootCause        String?
  workaround       String?
  createdAt        TimestamptzString @default(now())
  applications     Application[]
  knowledgeArticle KnowledgeArticle?
}

model KnowledgeArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String   @default("General")
  status    String   @default("DRAFT")
  problemId String?  @unique
  problem   Problem? @relation(fields: [problemId], references: [id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
