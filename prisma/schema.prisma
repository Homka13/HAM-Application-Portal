generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Application {
  id               String          @id @default(uuid())
  applicantName    String
  type             String          @default("SERVICE_REQUEST")
  priority         String          @default("LOW")
  status           String          @default("NEW")
  description      String?
  assignee         String?
  slaDeadline      DateTime?
  serviceCatalogId String?
  service          ServiceCatalog? @relation(fields: [serviceCatalogId], references: [id])
  changeRequestId  String?
  changeRequest    ChangeRequest?  @relation(fields: [changeRequestId], references: [id])
  createdAt        DateTime        @default(now())
  auditLogs        AuditLog[]
}


model AuditLog {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  field         String
  oldValue      String?
  newValue      String?
  changedBy     String
  createdAt     DateTime    @default(now())
}


model ServiceCatalog {
  id           String        @id @default(uuid())
  name         String        @unique
  category     String        @default("End-user Support")
  description  String?
  applications Application[]
}

model ChangeRequest {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String   @default("NORMAL") // STANDARD, NORMAL, EMERGENCY
  risk        String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String   @default("DRAFT") // DRAFT, PENDING, APPROVED, IMPLEMENTED, REJECTED
  scheduledAt DateTime
  requestedBy String
  approvedBy  String?
  createdAt   DateTime @default(now())
  applications Application[]
}
