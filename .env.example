# ==============================================================================
# HAM Portal Environment Variables Configuration (.env.example)
# ==============================================================================

# Server & Database Configuration
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ham"

# ------------------------------------------------------------------------------
# ClickUp Integration (R2)
# ------------------------------------------------------------------------------
CLICKUP_ENABLED=true
CLICKUP_API_KEY=""                # ClickUp personal API token (e.g., pk_...)
CLICKUP_LIST_ID=""               # Target List ID in ClickUp space
CLICKUP_WEBHOOK_SECRET=""        # HMAC Secret key for verifying inbound webhooks

# ------------------------------------------------------------------------------
# Notifications System (R3)
# ------------------------------------------------------------------------------
# Gmail / SMTP Email Channel
NOTIFICATIONS_EMAIL_ENABLED=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""                     # SMTP username
SMTP_PASS=""                     # SMTP password
GMAIL_USER=""                    # Gmail address
GMAIL_APP_PASSWORD=""            # Google App Password for 2FA
EMAIL_FROM="notifications@ham.local"

# Slack Webhook & Direct DM Channel
NOTIFICATIONS_SLACK_ENABLED=true
SLACK_WEBHOOK_URL=""             # General channel incoming webhook URL
SLACK_INCIDENT_WEBHOOK_URL=""    # Incident / Triage on-call alert webhook URL
SLACK_APPROVAL_WEBHOOK_URL=""    # Approvers channel webhook URL
SLACK_BOT_TOKEN=""               # Bot user OAuth token (xoxb-...) for user DM lookup
